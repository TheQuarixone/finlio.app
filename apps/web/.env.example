# Database (Supabase Postgres, via Drizzle). See docs/local-supabase.md.
# Locally these point at `supabase start`; on hosted Supabase, DATABASE_URL is
# the pooled connection and DIRECT_URL is the direct one used for migrations.
DATABASE_URL=
DIRECT_URL=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
INBOUND_FORWARD_TO=
