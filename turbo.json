{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["RESEND_API_KEY", "RESEND_FROM_EMAIL", "RESEND_WEBHOOK_SECRET", "NEXT_TELEMETRY_DISABLED"]
    },
    "lint": {},
    "typecheck": {
      // Depends on this package's own build, not just upstream: `next typegen`
      // and `next build` both write .next, so running them in parallel lets
      // build wipe the directory typegen is writing route types into.
      "dependsOn": ["build"]
    },
    "test": {},
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "email:dev": {
      "cache": false,
      "persistent": true
    }
  }
}
